# =====================================================================
# Salin file ini menjadi .env lalu isi sesuai aplikasi yang diuji.
#   cp .env.example .env
# File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# =====================================================================

# --- Target aplikasi -------------------------------------------------
# Jalankan SiLaundry dulu:  php artisan serve --host=127.0.0.1 --port=8000
BASE_URL=http://127.0.0.1:8000
APP_NAME=SiLaundry - Sistem Informasi Manajemen Laundry
TEST_ENV=local

# --- Akun pengujian (per role) ---------------------------------------
# Isi dengan akun uji dari seeder (lihat README proyek). Jangan pakai akun asli.
ADMIN_USER=admin@silaundry.test
ADMIN_PASS=
KASIR_USER=kasir@silaundry.test
KASIR_PASS=
PELANGGAN_USER=pelanggan1@silaundry.test
PELANGGAN_PASS=

# --- Discovery -------------------------------------------------------
DISCOVERY_MAX_PAGES=30
DISCOVERY_SKIP=logout,keluar,delete,hapus,destroy,remove

# --- Browser ---------------------------------------------------------
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
BROWSER_WS_ENDPOINT=

# --- Verifikasi data (Integration test, opsional) ---------------------
# Path mysql CLI untuk membandingkan angka di UI dengan isi database.
# Kosongkan → test integrasi tercatat BLOCKED.
MYSQL_CLI=C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin/mysql.exe
DB_HOST=127.0.0.1
DB_DATABASE=silaundry
DB_USERNAME=root
DB_PASSWORD=
